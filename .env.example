# ==============================================================================
# Multi-tenant Leave Management System Environment Variables
# ==============================================================================

# Application Port
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Neon PostgreSQL Connection Strings
# ------------------------------------------------------------------------------
# DATABASE_URL: Neon Pooled connection string (used by app runtime via PgBouncer).
# Host contains '-pooler' suffix. Must end with: ?sslmode=require&pgbouncer=true&connect_timeout=15
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# DIRECT_URL: Neon Direct connection string (used for Prisma migrations and seeds).
# Host does NOT contain '-pooler'. Must end with: ?sslmode=require
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# TEST_DATABASE_URL: Used for automated E2E tests (isolated Neon branch or test db)
TEST_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-test.ap-southeast-1.aws.neon.tech/neondb_test?sslmode=require"

# ------------------------------------------------------------------------------
# Authentication / JWT Secrets
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET="super-secret-jwt-access-token-key-min-32-chars-long"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-token-key-min-32-chars-long"

# ------------------------------------------------------------------------------
# Platform Root Administrator Seed Credentials
# ------------------------------------------------------------------------------
ROOT_EMAIL="root@example.com"
ROOT_NAME="Root Administrator"
ROOT_PASSWORD="ChangeMeSuperSecret123!"
