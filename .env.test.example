# ==============================================================================
# Neon PostgreSQL Test Environment Configuration (.env.test.example)
# Copy this to .env.test for running unit and E2E tests against Neon test branch.
# ==============================================================================

NODE_ENV=test
PORT=3001

# Neon Test Branch Pooled Connection (used by tests runtime)
# Must contain -pooler in hostname and &pgbouncer=true
TEST_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-crimson-sky-bedpv6o3-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Neon Test Branch Direct Connection (used for migrations and raw DDL)
# Must match the same branch endpoint ID as TEST_DATABASE_URL without -pooler
TEST_DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-crimson-sky-bedpv6o3.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require"

# DATABASE_URL and DIRECT_URL should point to test branch when running tests
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-crimson-sky-bedpv6o3-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-crimson-sky-bedpv6o3.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Test Branch Allowlist (hostnames permitted for testing)
TEST_BRANCH_HOST_ALLOWLIST="ep-crimson-sky-bedpv6o3.c-9.us-east-2.aws.neon.tech,ep-crimson-sky-bedpv6o3-pooler.c-9.us-east-2.aws.neon.tech"

# JWT Secrets for Testing
JWT_ACCESS_SECRET="7fKp9vQ2mX8cR4tL6wN3yH5jB9sD1aE0uG4iZ7oC2pM6vT8x"
JWT_REFRESH_SECRET="R3mY8kL2pW6qN9vB4xF7sC1jH5dT0aZ3uE6iG8oQ2mK9wP1"

# Throttle disabled during general test suites
THROTTLE_DISABLED=true
